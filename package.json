{
  "name": "grantlattice",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "check": "npm run check:contract && npm run check:tests && npm run check:deployment && npm run check:frontend",
    "check:contract": "set PYTHONUTF8=1&& .venv\\Scripts\\genvm-lint.exe check contracts/grant_lattice.py",
    "check:tests": ".venv\\Scripts\\python.exe -m pytest tests -q",
    "check:deployment": "node --test tests/deployment/*.test.mjs",
    "check:frontend": "npm --workspace frontend test && npm --workspace frontend run typecheck && npm --workspace frontend run build",
    "lint:contracts": ".venv\\Scripts\\genvm-lint.exe check contracts/grant_lattice.py",
    "test:direct": ".venv\\Scripts\\python.exe -m pytest tests/direct -q",
    "test:frontend": "npm --workspace frontend test",
    "typecheck": "npm --workspace frontend run typecheck",
    "build": "npm --workspace frontend run build",
    "studionet:inspect": "node scripts/studionet.mjs inspect",
    "studionet:prepare-delegate": "node scripts/studionet.mjs prepare-delegate",
    "studionet:recover-delegate": "node scripts/studionet.mjs recover-delegate-funding",
    "studionet:deploy": "node scripts/studionet.mjs deploy",
    "studionet:lifecycle": "node scripts/studionet.mjs lifecycle"
  },
  "dependencies": {
    "genlayer-js": "1.1.8"
  }
}
